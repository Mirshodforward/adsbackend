NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres@localhost:5432/osontarget

JWT_ACCESS_SECRET=   # openssl rand -base64 48
JWT_ACCESS_TTL_SEC=900
REFRESH_TTL_DAYS=30

# Frontend (BFF) bilan umumiy sir — productionda majburiy, lokalda bo'sh bo'lishi mumkin.
# Ikkala tomonda bir xil: openssl rand -hex 32
INTERNAL_API_SECRET=

# @BotFather → /newbot, keyin /setdomain (prod: osontarget.uz; lokal sinov uchun alohida bot + 127.0.0.1)
TELEGRAM_BOT_TOKEN=
TELEGRAM_AUTH_MAX_AGE_SEC=86400

# ads.telegram.org/account/api — asosiy reklama hisobining tokeni
TELEGRAM_ADS_API_KEY=

# Optimizator: e'lonlar va statistikani har 5 daqiqada sinxronlash (lokalda odatda o'chiq)
ADS_SYNC_ENABLED=false
# Login paytida admin bo'ladigan Telegram ID'lar (vergul bilan)
ADMIN_TELEGRAM_IDS=

# ─── To'lovlar: balansni to'ldirish (PAYMENTS.md) ───
# Paylinker → OsonTarget loyihasi. Kalit bo'sh bo'lsa to'lov o'chiq (usullar ro'yxati bo'sh).
PAYLINKER_API_BASE=https://api.paylinker.uz
PAYLINKER_API_KEY=
# Webhook imzosi (whsec_…). Bo'sh bo'lsa webhook 503 qaytaradi.
PAYLINKER_WEBHOOK_SECRET=
# Paynet ilova havolasidagi `m` (Paynet beradi). Bo'sh bo'lsa Paynet ko'rinmaydi.
PAYNET_APP_MERCHANT=
# Yoqilgan usullar (vergul bilan)
PAYMENT_METHODS=CLICK,PAYME,UZUM,PAYNET
TOPUP_MIN_UZS=10000
TOPUP_MAX_UZS=2500000
# Mijoz to'lovga qo'shimcha to'laydigan komissiya, %. 0 — komissiyani biz ko'taramiz.
TOPUP_FEE_PERCENT=0
