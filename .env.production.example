# ─── Server .env (production, pm2) ───────────────────────────────────────────
# Serverda: cp .env.production.example .env && chmod 600 .env — keyin to'ldiring.
NODE_ENV=production
# nginx ortida: port faqat lokal interfeysda ochiladi.
HOST=127.0.0.1
PORT=4400

# Tizimdagi PostgreSQL. Parol faqat hex bo'lsin — URL'ni buzadigan belgilar
# (+ / =) chiqmaydi:  openssl rand -hex 32
DATABASE_URL=postgresql://osontarget:PAROL@127.0.0.1:5432/osontarget

# openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SEC=900
REFRESH_TTL_DAYS=30

# Vercel'dagi frontend bilan AYNAN bir xil qiymat:  openssl rand -hex 32
INTERNAL_API_SECRET=

# @Osontarget_bot tokeni (@BotFather). /setdomain → osontarget.uz
TELEGRAM_BOT_TOKEN=
TELEGRAM_AUTH_MAX_AGE_SEC=86400

# ads.telegram.org/account/api
TELEGRAM_ADS_API_KEY=

# E'lonlar va statistikani Telegram Ads'dan har 5 daqiqada sinxronlash
ADS_SYNC_ENABLED=true
# Login paytida admin bo'ladigan Telegram ID'lar (vergul bilan)
ADMIN_TELEGRAM_IDS=

# ─── To'lovlar: balansni to'ldirish (PAYMENTS.md) ───
# Paylinker → OsonTarget loyihasi. Kalit bo'sh bo'lsa to'lov o'chiq (usullar ro'yxati bo'sh).
PAYLINKER_API_BASE=https://api.paylinker.uz
PAYLINKER_API_KEY=
# Webhook imzosi (whsec_…). Bo'sh bo'lsa webhook 503 qaytaradi.
PAYLINKER_WEBHOOK_SECRET=
# Paynet ilova havolasidagi `m` — xizmat raqami (Paynet beradi; umumiy shartnomada StarsPaymee bilan bir xil).
# Bo'sh bo'lsa Paynet ko'rinmaydi.
PAYNET_APP_MERCHANT=
# Yoqilgan usullar (vergul bilan)
PAYMENT_METHODS=CLICK,PAYME,UZUM,PAYNET
# Summa chegaralari va komissiya — admin panelidagi sozlamalarda (bazada).
