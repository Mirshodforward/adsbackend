# ─── Server .env (production) — docker-compose.prod.yml shu faylni o'qiydi ───
# Serverda: cp .env.production.example .env  va qiymatlarni to'ldiring.

# Postgres (compose ichidagi baza). Parol faqat hex bo'lsin — DATABASE_URL'ni
# buzadigan belgilar (+ / =) chiqmaydi:  openssl rand -hex 32
POSTGRES_DB=osontarget
POSTGRES_USER=osontarget
POSTGRES_PASSWORD=

# openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SEC=900
REFRESH_TTL_DAYS=30

# Vercel'dagi frontend bilan AYNAN bir xil qiymat:  openssl rand -hex 32
INTERNAL_API_SECRET=

# @Osontarget_bot tokeni (@BotFather). /setdomain → osontarget.uz
TELEGRAM_BOT_TOKEN=
TELEGRAM_AUTH_MAX_AGE_SEC=86400

# ads.telegram.org/account/api
TELEGRAM_ADS_API_KEY=
