generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  CLIENT // reklama beruvchi mijoz
  ADMIN // platforma administratori
}

// ─── Foydalanuvchilar ────────────────────────────────────────────────────────

/// Telegram Login Widget orqali kirgan foydalanuvchi.
model User {
  id          String    @id @default(cuid())
  /// Telegram user ID — 2^31 dan oshib ketadi, shuning uchun BigInt.
  telegramId  BigInt    @unique
  firstName   String
  lastName    String?
  username    String?
  photoUrl    String?
  role        Role      @default(CLIENT)
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  /// Mijozga ko'rsatiladigan hisob raqami: 8 xonali, 0 bilan boshlanmaydi
  /// (to'lov terminali, qo'llab-quvvatlash). Telegram ID o'rniga — u boshqa
  /// loyihalarda ham login bo'lgani uchun to'lov tizimida to'qnashadi.
  clientId   Int     @unique @default(dbgenerated("((floor((random() * (90000000)::double precision)) + (10000000)::double precision))::integer"))
  /// Bo'sh balans (so'm): yangi e'lonlarga ajratish mumkin bo'lgan pul.
  /// Faqat BalanceService orqali o'zgaradi (jurnal bilan bitta tranzaksiyada).
  balanceUzs Decimal @default(0) @db.Decimal(14, 2)

  sessions          Session[]
  balanceEntries    BalanceEntry[]
  clientAds         ClientAd[]
  fundingOperations FundingOperation[]
}

/// Refresh token sessiyasi. Tokenning o'zi saqlanmaydi — faqat SHA-256 xeshi.
model Session {
  id        String    @id @default(cuid())
  userId    String
  /// Bitta login'dan tug'ilgan barcha (rotatsiya qilingan) tokenlar oilasi.
  /// Logout yoki eski token qayta ishlatilsa butun oila bekor qilinadi.
  familyId  String
  tokenHash String    @unique
  expiresAt DateTime
  /// Token yangisiga almashtirilgan payt — grace oynasi shundan hisoblanadi.
  rotatedAt DateTime?
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

// ─── Telegram Ads ────────────────────────────────────────────────────────────

/// Telegram Ads'dagi e'lonning bazadagi nusxasi — sinxronlash har 5 daqiqada yangilaydi.
/// Pul qiymatlari hisob valyutasida (hozir TON).
model Ad {
  /// Telegram ad_id (API: 32-bit butun son).
  adId             Int      @id
  title            String
  text             String
  promoteUrl       String
  placement        String
  /// stopped | ready_for_review | in_review | declined | active | on_hold
  status           String
  isPaused         Boolean
  /// Masalan start_bot, join — CPA shu harakat bo'yicha hisoblanadi.
  actionType       String?
  currency         String
  cpm              Decimal  @db.Decimal(18, 5)
  dailyBudgetLimit Decimal? @db.Decimal(18, 5)
  spentBudget      Decimal  @db.Decimal(18, 5)
  remainingBudget  Decimal  @db.Decimal(18, 5)
  views            Int
  clicks           Int
  actions          Int
  declineReason    String?
  /// API javobining o'zi — yangi maydonlar sxemaga qo'shilmaguncha ham saqlanadi.
  raw              Json
  createdDate      DateTime
  syncedAt         DateTime @updatedAt

  stats           AdStat[]
  recommendations Recommendation[]
  clientAd        ClientAd?
}

/// 5 daqiqalik statistika (getAdStats, interval=300). `fromTime` — oraliq boshi.
model AdStat {
  adId     Int
  fromTime DateTime
  views    Int
  clicks   Int
  actions  Int
  spent    Decimal  @db.Decimal(18, 5)

  ad Ad @relation(fields: [adId], references: [adId], onDelete: Cascade)

  @@id([adId, fromTime])
}

enum RecommendationKind {
  ADD_BUDGET // budjet tez orada tugaydi
  PAUSE // samarasiz e'lon
  RAISE_CPM // auksionda yutqazmoqda — kam ko'rsatilmoqda
}

enum RecommendationStatus {
  PENDING
  APPLIED
  DISMISSED
  EXPIRED // sharoit o'zgardi yoki e'lon boshqa joyda o'zgartirildi
  FAILED
}

/// Optimizator tavsiyasi. Qo'llanganlari — pulni o'zgartirgan amallar jurnali ham.
model Recommendation {
  id          String               @id @default(cuid())
  adId        Int
  kind        RecommendationKind
  status      RecommendationStatus @default(PENDING)
  /// Admin o'qiydigan izoh, raqamlar bilan.
  reason      String
  /// Bajariladigan o'zgarish: {"amount": 0.96} yoki {"cpm": 0.25}.
  change      Json
  /// Tavsiya paytidagi qiymatlar — qo'llashdan oldin hozirgi holat bilan solishtiriladi.
  snapshot    Json
  error       String?
  createdAt   DateTime             @default(now())
  decidedAt   DateTime?
  decidedById String?

  ad Ad @relation(fields: [adId], references: [adId], onDelete: Cascade)

  @@index([status])
  @@index([adId, kind, status])
}

// ─── Balans va mijoz e'lonlari ───────────────────────────────────────────────

enum BalanceEntryType {
  TOPUP // to'lov orqali to'ldirish (+)
  AD_FUNDING // e'lon budjetiga ajratildi (−)
  AD_REFUND // e'londan ishlatilmagan qoldiq qaytdi (+)
  ADJUSTMENT // admin tuzatishi (±)
}

/// Bo'sh balans harakatlari jurnali — faqat qo'shiladi, o'zgartirilmaydi.
model BalanceEntry {
  id              String           @id @default(cuid())
  userId          String
  type            BalanceEntryType
  /// Bo'sh balansga ta'siri: + kirim, − chiqim.
  amountUzs       Decimal          @db.Decimal(14, 2)
  /// Shu yozuvdan keyingi bo'sh balans.
  balanceAfterUzs Decimal          @db.Decimal(14, 2)
  adId            Int?
  operationId     String?
  /// To'lov manbasi va uning tranzaksiya id'si: takroriy webhook ikki marta yozilmaydi.
  source          String?
  externalId      String?
  note            String?
  createdAt       DateTime         @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([source, externalId])
  @@index([userId, createdAt])
}

enum FundingKind {
  CREATE_AD // yangi e'lon (initial_budget)
  ADD_BUDGET // mavjud e'longa budjet qo'shish
  CLOSE_AD // e'lonni yakunlash: qoldiqni balansga qaytarish
}

enum FundingStatus {
  PENDING
  DONE
  FAILED
}

/// Pul Telegram Ads bilan almashinadigan amal. Avval balans o'zgaradi va shu
/// yozuv yaratiladi, keyin Telegram chaqiriladi (idempotency_key = id). Javob
/// kelmay qolsa, sinxronlash shu kalit bilan qayta urinadi — pul ikki marta o'tmaydi.
model FundingOperation {
  id        String        @id @default(cuid())
  userId    String
  kind      FundingKind
  status    FundingStatus @default(PENDING)
  adId      Int?
  amountUzs Decimal       @db.Decimal(14, 2)
  amountTon Decimal       @db.Decimal(18, 5)
  /// Telegram'ga yuboriladigan parametrlar.
  request   Json
  error     String?
  attempts  Int           @default(0)
  /// CLOSE_AD: Telegram e'lon kamida 10 daqiqa nofaol bo'lishini talab qiladi.
  notBefore DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([status])
  @@index([userId])
}

/// Mijoz e'loni: Telegram'dagi e'lon ↔ egasi va uning hisob-kitobi.
/// O'rtacha kurs = fundedUzs / fundedTon (budjet turli kurslarda qo'shilishi mumkin).
model ClientAd {
  adId        Int       @id
  userId      String
  fundedUzs   Decimal   @default(0) @db.Decimal(14, 2)
  fundedTon   Decimal   @default(0) @db.Decimal(18, 5)
  /// Telegram'dagi spent_budget × o'rtacha kurs — har sinxronlashda qayta hisoblanadi.
  spentUzs    Decimal   @default(0) @db.Decimal(14, 2)
  refundedUzs Decimal   @default(0) @db.Decimal(14, 2)
  closedAt    DateTime?
  createdAt   DateTime  @default(now())

  ad   Ad   @relation(fields: [adId], references: [adId])
  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

/// Platforma sozlamalari (kalit → JSON): TON kursi, komissiya, minimal budjet.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
